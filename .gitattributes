# 统一行尾，避免 Windows 克隆后 shell 脚本变 CRLF 导致容器启动失败
* text=auto eol=lf

# 脚本必须保持 LF
*.sh text eol=lf
entrypoint.sh text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.xls binary
*.zip binary

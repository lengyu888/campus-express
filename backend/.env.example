# 后端本地开发环境变量（复制为 .env 后按需修改）
APP_NAME=校园快递收发系统
DATABASE_URL=mysql+pymysql://campus:campus_pass@127.0.0.1:3306/campus_express?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
